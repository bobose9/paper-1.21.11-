package com.simpleteleport;

import io.papermc.paper.event.player.AsyncChatEvent;
import net.kyori.adventure.text.Component;
import net.kyori.adventure.text.event.ClickEvent;
import net.kyori.adventure.text.format.NamedTextColor;
import org.bukkit.Bukkit;
import org.bukkit.command.Command;
import org.bukkit.command.CommandExecutor;
import org.bukkit.command.CommandSender;
import org.bukkit.entity.Player;
import org.bukkit.event.EventHandler;
import org.bukkit.event.Listener;
import org.bukkit.plugin.java.JavaPlugin;

import java.util.HashMap;
import java.util.Map;
import java.util.UUID;

public class SimpleTeleport extends JavaPlugin implements CommandExecutor, Listener {
    private final Map<UUID, UUID> pendingRequests = new HashMap<>();

    @Override
    public void onEnable() {
        this.getCommand("tpa").setExecutor(this);
        Bukkit.getPluginManager().registerEvents(this, this);
        getLogger().info("SimpleTeleport 插件已启用！");
    }

    @Override
    public boolean onCommand(CommandSender sender, Command cmd, String label, String[] args) {
        if (!(sender instanceof Player requester)) {
            sender.sendMessage(Component.text("只有玩家可以使用此命令！", NamedTextColor.RED));
            return true;
        }
        if (args.length != 1) {
            requester.sendMessage(Component.text("用法: /tpa <玩家名>", NamedTextColor.YELLOW));
            return true;
        }
        Player target = Bukkit.getPlayer(args[0]);
        if (target == null) {
            requester.sendMessage(Component.text("该玩家不在线！", NamedTextColor.RED));
            return true;
        }
        if (target.getUniqueId().equals(requester.getUniqueId())) {
            requester.sendMessage(Component.text("不能传送到自己！", NamedTextColor.RED));
            return true;
        }
        pendingRequests.put(target.getUniqueId(), requester.getUniqueId());

        Component msg = Component.text(requester.getName() + " 请求传送到你！ ")
                .append(Component.text("[同意]", NamedTextColor.GREEN).clickEvent(ClickEvent.runCommand("/tpaccept")))
                .append(Component.text(" "))
                .append(Component.text("[拒绝]", NamedTextColor.RED).clickEvent(ClickEvent.runCommand("/tpdeny")));
        target.sendMessage(msg);
        requester.sendMessage(Component.text("传送请求已发送给 " + target.getName(), NamedTextColor.GREEN));
        return true;
    }

    @EventHandler
    public void onChat(AsyncChatEvent event) {
        Player player = event.getPlayer();
        String msg = event.message().plainText();
        UUID requesterId = pendingRequests.get(player.getUniqueId());
        if (requesterId == null) return;

        if (msg.equalsIgnoreCase("tpaccept")) {
            event.setCancelled(true);
            Player requester = Bukkit.getPlayer(requesterId);
            if (requester != null) {
                requester.teleport(player.getLocation());
                requester.sendMessage(Component.text("传送成功！", NamedTextColor.GREEN));
                player.sendMessage(Component.text("已同意传送！", NamedTextColor.GREEN));
            }
            pendingRequests.remove(player.getUniqueId());
        } else if (msg.equalsIgnoreCase("tpdeny")) {
            event.setCancelled(true);
            Player requester = Bukkit.getPlayer(requesterId);
            if (requester != null) {
                requester.sendMessage(Component.text("传送请求被拒绝", NamedTextColor.RED));
            }
            player.sendMessage(Component.text("已拒绝传送！", NamedTextColor.RED));
            pendingRequests.remove(player.getUniqueId());
        }
    }
}
